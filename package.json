{
  "name": "undr-ctrl",
  "productName": "Undr Ctrl",
  "version": "1.5.0",
  "description": "Undr Ctrl \u2014 a calm, gamified to-do, money and focus app",
  "author": "Chloe",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:web": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/build-electron.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "sweep": "node scripts/sweep.cjs",
    "release": "./scripts/release.sh"
  },
  "build": {
    "appId": "app.undrctrl.desktop",
    "productName": "Undr Ctrl",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Undr-Ctrl-Setup.exe",
      "shortcutName": "Undr Ctrl"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yiirii",
        "repo": "undr-ctrl",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "electron-updater": "^6.8.11",
    "firebase": "^11.10.0",
    "framer-motion": "^11.18.2",
    "music-metadata": "^11.16.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
